# DeepSeek（默认）
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-v4-flash

# 或 OpenAI
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini 图像生成（画图后端）
# GOOGLE_API_KEY=AIza-your-key
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# 画图后端：comfyui（本地）| gemini（谷歌）| auto（优先本地，不可用时自动切 Gemini）
# IMAGE_BACKEND=auto

# OpenRouter（可在网页中切换）
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# Langfuse 运行监控与评测（可选）
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key
# LANGFUSE_SECRET_KEY=sk-lf-your-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Telegram Bot（从 @BotFather 获取）
# TELEGRAM_BOT_TOKEN=
# 每 30 秒独立探活；连续 5 次失败或 180 秒内出现 8 次轮询错误时自动重启。
TELEGRAM_WATCHDOG_INTERVAL=30
TELEGRAM_WATCHDOG_FAILURE_LIMIT=5
TELEGRAM_POLLING_FAILURE_LIMIT=8
TELEGRAM_POLLING_FAILURE_WINDOW=180

# 本地 OpenAI 兼容模型
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=qwen3.8-27b-local
LOCAL_MODEL_IDLE_TIMEOUT=300
LOCAL_LLAMA_SERVER=/home/administrator/llama.cpp-cuda/build-cuda/bin/llama-server
LOCAL_MODEL_PATH=/home/administrator/models/qwen3.8-27b/Qwen3.8-27B-Q4_K_M.gguf
LOCAL_MODEL_CTX=16384
LOCAL_HISTORY_TOKENS=4096
LOCAL_MODEL_MAX_OUTPUT_TOKENS=800
LOCAL_MODEL_NATIVE_CTX=262144
LOCAL_MODEL_REASONING=off
LOCAL_MODEL_GPU_LAYERS=99
# 每次启动前释放本项目遗留模型和空闲 ComfyUI 的内存/显存；ComfyUI 忙时拒绝抢占。
LOCAL_MODEL_PREFLIGHT_COMFYUI=true
LOCAL_MODEL_PREFLIGHT_STRICT=true
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# 公网试用保护（启用后除健康检查外，网页和接口均要求 HTTP Basic 登录）
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_USERNAME=trial
PUBLIC_DEMO_PASSWORD=replace-with-a-long-random-password
PUBLIC_DEMO_RATE_LIMIT=30

# 接真实业务接口时填写；留空则使用本地 mock 数据
# RFID_API_BASE=http://ip:port
# RFID_API_TOKEN=
# RFID_BUILD_ID=1
